  window.mailAutoProcessNow = mailAutoProcessNow;
  window.mailAutoViewLog = mailAutoViewLog;
  window.filterDashboardEmails = filterDashboardEmails;
  // Hermes exports
  window.hermesSendMessage = hermesSendMessage;
