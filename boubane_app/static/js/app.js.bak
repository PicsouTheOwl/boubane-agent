  window.mailDelete = mailDelete;
  window.mailDeleteSelected = mailDeleteSelected;
  window.mailArchive = mailArchive;
  window.mailArchiveSelected = mailArchiveSelected;
  window.mailMoveTo = mailMoveTo;
  window.mailReply = mailReply;
